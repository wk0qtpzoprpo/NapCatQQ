# ===== NapCat =====
# 机器人 QQ 号（留空则每次手动扫码）
ACCOUNT=
# 运行 UID/GID（默认 1000；建议使用宿主机用户 id -u / id -g）
NAPCAT_UID=1000
NAPCAT_GID=1000
# 时区
TZ=Asia/Shanghai
# OneBot 连接模式（可选：reverse_ws / reverse_http / astrbot / napcat），留空则用 WebUI 配置
MODE=
ONEBOT_URL=

# ===== 端口 =====
WEBUI_PORT=6099
HTTP_PORT=3000
WS_PORT=3001

# ===== 数据目录（宿主机） =====
DATA_DIR=./data

# ===== 容器与镜像 =====
CONTAINER_NAME=napcat
# GHCR 自动构建产物；本地构建可用 napcat-b2:latest
IMAGE=ghcr.io/wk0qtpzoprpo/napcat-b2:latest

# ===== Backblaze B2 =====
# Application Key 需要权限：读写 + listAllBucketNames
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# B2 内路径前缀（多实例共用一桶时区分，默认 napcat）
B2_PREFIX=napcat
